{
  "name": "gymbuddie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.6.4"
  },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "audit": "npm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check": "npm run lockfile:check && npm run lint && npm run format:check && npm run test:unit && npm run build && npm run verify:pwa",
    "verify:pwa": "node scripts/verify-pwa-build.mjs",
    "lockfile:check": "npm ci --dry-run --ignore-scripts --no-audit --no-fund"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.6.4",
      "onFail": "error"
    }
  }
}
